# CELL 8: ADAPTIVE HYBRID ALGORITHM
# ================================

HYBRID_THRESHOLD = 20


def adaptive_closest_pair(points, threshold=HYBRID_THRESHOLD):

    sorted_points = sorted(
        points,
        key=lambda p: p[0]
    )

    return adaptive_recursive(
        sorted_points,
        threshold
    )


def adaptive_recursive(points, threshold):

    n = len(points)

    # Dynamically switch to brute force
    # for small subproblems
    if n <= threshold:
        return brute_force(points)

    # Divide
    mid = n // 2

    left = points[:mid]
    right = points[mid:]

    # Recursive calls
    left_pair, left_distance = adaptive_recursive(
        left,
        threshold
    )

    right_pair, right_distance = adaptive_recursive(
        right,
        threshold
    )

    # Select better result
    if left_distance < right_distance:
        best_pair = left_pair
        min_distance = left_distance
    else:
        best_pair = right_pair
        min_distance = right_distance

    # Middle coordinate
    mid_x = points[mid][0]

    # Build strip
    strip = [
        p for p in points
        if abs(p[0] - mid_x) < min_distance
    ]

    # Sort strip according to y-coordinate
    strip.sort(key=lambda p: p[1])

    # Compare points in strip
    for i in range(len(strip)):

        j = i + 1

        while j < len(strip):

            if (strip[j][1] - strip[i][1]) >= min_distance:
                break

            distance = euclidean_distance(
                strip[i],
                strip[j]
            )

            if distance < min_distance:
                min_distance = distance
                best_pair = (
                    strip[i],
                    strip[j]
                )

            j += 1

    return best_pair, min_distance
