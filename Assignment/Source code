# CELL 6: BRUTE FORCE ALGORITHM
# ================================

def brute_force(points):

    n = len(points)

    if n < 2:
        return None, float("inf")

    min_distance = float("inf")
    closest_pair = None

    for i in range(n):
        for j in range(i + 1, n):

            distance = euclidean_distance(
                points[i],
                points[j]
            )

            if distance < min_distance:
                min_distance = distance
                closest_pair = (
                    points[i],
                    points[j]
                )

    return closest_pair, min_distance
    # ================================
# CELL 7: DIVIDE AND CONQUER
# ================================

def closest_pair_recursive(points_sorted_x):

    n = len(points_sorted_x)

    # Small problem
    if n <= 3:
        return brute_force(points_sorted_x)

    # Find middle
    mid = n // 2

    left = points_sorted_x[:mid]
    right = points_sorted_x[mid:]

    # Recursively solve left and right
    pair_left, dist_left = closest_pair_recursive(left)
    pair_right, dist_right = closest_pair_recursive(right)

    # Select smaller distance
    if dist_left < dist_right:
        best_pair = pair_left
        min_distance = dist_left
    else:
        best_pair = pair_right
        min_distance = dist_right

    # Middle x coordinate
    mid_x = points_sorted_x[mid][0]

    # Create strip
    strip = [
        p for p in points_sorted_x
        if abs(p[0] - mid_x) < min_distance
    ]

    # Sort strip by y-coordinate
    strip.sort(key=lambda p: p[1])

    # Compare points in strip
    for i in range(len(strip)):

        j = i + 1

        while j < len(strip):

            if (strip[j][1] - strip[i][1]) >= min_distance:
                break

            distance = euclidean_distance(
                strip[i],
                strip[j]
            )

            if distance < min_distance:
                min_distance = distance
                best_pair = (
                    strip[i],
                    strip[j]
                )

            j += 1

    return best_pair, min_distance


def divide_and_conquer(points):

    sorted_points = sorted(
        points,
        key=lambda p: p[0]
    )

    return closest_pair_recursive(
        sorted_points
    )

